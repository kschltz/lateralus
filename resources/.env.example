OPENAI_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key

# Memory embeddings (default: LangChain4j in-process, no network)
# LATERALUS_EMBEDDING_METHOD=langchain4j
# LATERALUS_EMBEDDING_MODEL=all-minilm-l6-v2-q
# LATERALUS_MEMORY_EMBEDDING_DIMS=384

# Optional HTTP embeddings (Ollama/OpenAI-compatible)
# LATERALUS_EMBEDDING_METHOD=http
# LATERALUS_EMBEDDING_MODEL=nomic-embed-text