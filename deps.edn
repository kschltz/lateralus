{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        hato/hato {:mvn/version "1.0.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        datalevin/datalevin {:mvn/version "0.10.7"}
        borkdude/edamame {:mvn/version "1.5.37"}
        parinferish/parinferish {:mvn/version "0.8.0"}
        metosin/malli {:mvn/version "0.16.4"}
        dev.langchain4j/langchain4j-embeddings-all-minilm-l6-v2-q {:mvn/version "1.12.2-beta22"}
        djblue/portal {:mvn/version "0.64.1"}
        nrepl/nrepl {:mvn/version "1.3.1"}
        rewrite-clj/rewrite-clj {:mvn/version "1.2.54"}}
 :aliases
 {:jvm-base {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                        "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                        "--enable-native-access=ALL-UNNAMED"]}
  :run-m {:main-opts ["-m" "kschltz.lateralus"]
          :aliases [:jvm-base]}
  :run-x {:ns-default kschltz.lateralus
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.13"}}
          :ns-default build}
  :nrepl {:extra-deps {cider/cider-nrepl {:mvn/version "0.52.0"}}
          :jvm-opts ["-Drepl.port=59500"]}
  :nrepl-server {:main-opts ["-m" "kschltz.agent.nrepl-server"]}
  :cli {:main-opts ["-m" "kschltz.lateralus"]
        :aliases [:jvm-base]}
  :sim {:extra-paths ["scripts"]
        :exec-fn simulate-complex-tool-session/-main}
  :demo {:extra-paths ["scripts"]
         :exec-fn live-tool-demo/-main}
  :cloud-demo {:extra-paths ["scripts"]
               :exec-fn live-ollama-cloud-demo/-main}
  :test {:extra-paths ["test"]
         :aliases [:jvm-base]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
